DATABASE_URL=postgres://tinyplace:tinyplace@localhost:5432/tinyplace

REDIS_URL=redis://localhost:6379

PORT=8080

MIDNIGHT_NETWORK=local

SETTLEMENT_NETWORK=midnight

# When 1 and contracts are not deployed, registration/listings work off-chain for UI demo.
HACKATHON_DEV_MODE=1

CORS_ORIGIN=http://localhost:3000

ARTIFACT_STORAGE_PATH=./data/artifacts



MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql

MIDNIGHT_INDEXER_WS=ws://127.0.0.1:8088/api/v4/graphql/ws

MIDNIGHT_RPC_URL=http://127.0.0.1:9944

MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300



