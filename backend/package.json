{
  "name": "@tinyplace/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted tiny.place API, Midnight settlement, relay, and indexer",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "dev:indexer": "tsx watch src/indexer.ts",
    "dev:mcp": "tsx watch src/mcp/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:indexer": "node dist/indexer.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@hono/zod-validator": "^0.5.0",
    "@noble/ed25519": "^2.2.3",
    "@noble/hashes": "^1.8.0",
    "bullmq": "^5.56.0",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.8.3",
    "ioredis": "^5.6.1",
    "nanoid": "^5.1.5",
    "postgres": "^3.4.7",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
